{
  "$description": "Soft/clean house tokens. Colors are semantic roles with light and dark values. text-faint is for disabled/decorative text only (below 4.5:1 by design). Edit here, then run: python scripts/build_tokens.py",
  "color": {
    "bg": {
      "light": "#ffffff",
      "dark": "#212121"
    },
    "bg-subtle": {
      "light": "#f9f9f9",
      "dark": "#181818"
    },
    "surface": {
      "light": "#ffffff",
      "dark": "#2a2a2a"
    },
    "surface-hover": {
      "light": "#f3f3f3",
      "dark": "#333333"
    },
    "surface-active": {
      "light": "#ececec",
      "dark": "#3a3a3a"
    },
    "text": {
      "light": "#0d0d0d",
      "dark": "#ececec"
    },
    "text-muted": {
      "light": "#5d5d5d",
      "dark": "#b4b4b4"
    },
    "text-faint": {
      "light": "#8f8f8f",
      "dark": "#8a8a8a"
    },
    "border": {
      "light": "#0000000f",
      "dark": "#ffffff14"
    },
    "primary": {
      "light": "#0d0d0d",
      "dark": "#f3f3f3"
    },
    "primary-fg": {
      "light": "#ffffff",
      "dark": "#0d0d0d"
    },
    "accent": {
      "light": "#2563eb",
      "dark": "#6b9cff"
    },
    "danger": {
      "light": "#c42b36",
      "dark": "#ff6b6b"
    },
    "success": {
      "light": "#1a7f4b",
      "dark": "#4cc38a"
    },
    "focus": {
      "light": "#2563eb80",
      "dark": "#6b9cff99"
    },
    "scrim": {
      "light": "#ffffffc7",
      "dark": "#212121c7"
    },
    "wash": {
      "light": "#0d0d0d0f",
      "dark": "#ffffff14"
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "size": {
    "control-sm": "32px",
    "control": "36px",
    "control-lg": "40px",
    "touch": "44px",
    "sidebar": "272px",
    "reading": "720px"
  },
  "font": {
    "sans": "ui-sans-serif, -apple-system, system-ui, 'Segoe UI', Inter, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace"
  },
  "text": {
    "xs": "12px",
    "sm": "13px",
    "base": "14px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "2xl": "32px"
  },
  "weight": {
    "regular": "400",
    "medium": "500",
    "semibold": "600"
  },
  "leading": {
    "tight": "1.2",
    "snug": "1.35",
    "normal": "1.5",
    "relaxed": "1.65"
  },
  "shadow": {
    "ring": {
      "light": "0 0 0 1px oklch(0 0 0 / 0.06), 0 1px 2px -1px oklch(0 0 0 / 0.06), 0 2px 4px 0 oklch(0 0 0 / 0.04)",
      "dark": "inset 0 1px 0 0 rgb(255 255 255 / 0.03), inset 0 0 0 1px rgb(255 255 255 / 0.045), 0 0 0 1px rgb(0 0 0 / 0.14), 0 1px 2px -1px rgb(0 0 0 / 0.14), 0 2px 4px 0 rgb(0 0 0 / 0.08)"
    },
    "ring-hover": {
      "light": "0 0 0 1px oklch(0 0 0 / 0.08), 0 1px 2px -1px oklch(0 0 0 / 0.08), 0 2px 4px 0 oklch(0 0 0 / 0.06)",
      "dark": "inset 0 1px 0 0 rgb(255 255 255 / 0.05), inset 0 0 0 1px rgb(255 255 255 / 0.07), 0 0 0 1px rgb(0 0 0 / 0.14), 0 1px 2px -1px rgb(0 0 0 / 0.14), 0 2px 4px 0 rgb(0 0 0 / 0.08)"
    },
    "float": {
      "light": "0 0 0 1px oklch(0 0 0 / 0.06), 0 4px 12px -2px oklch(0 0 0 / 0.08), 0 12px 32px -8px oklch(0 0 0 / 0.10)",
      "dark": "inset 0 1px 0 0 rgb(255 255 255 / 0.04), inset 0 0 0 1px rgb(255 255 255 / 0.06), 0 0 0 1px rgb(0 0 0 / 0.2), 0 4px 12px -2px rgb(0 0 0 / 0.3), 0 12px 32px -8px rgb(0 0 0 / 0.4)"
    },
    "overlay": {
      "light": "0 0 0 1px oklch(0 0 0 / 0.05), 0 24px 64px -12px oklch(0 0 0 / 0.20)",
      "dark": "inset 0 1px 0 0 rgb(255 255 255 / 0.05), inset 0 0 0 1px rgb(255 255 255 / 0.06), 0 0 0 1px rgb(0 0 0 / 0.25), 0 24px 64px -12px rgb(0 0 0 / 0.6)"
    },
    "primary": {
      "light": "0 0 0 1px rgb(0 0 0 / 0.6), 0 1px 2px -1px rgb(0 0 0 / 0.4), 0 2px 4px 0 rgb(0 0 0 / 0.18)",
      "dark": "inset 0 1px 0 0 rgb(255 255 255 / 0.45), 0 0 0 1px rgb(255 255 255 / 0.55), 0 1px 2px 0 rgb(0 0 0 / 0.5)"
    }
  },
  "ease": {
    "out": "cubic-bezier(0.23, 1, 0.32, 1)",
    "in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
    "drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
    "spring": "linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1)"
  },
  "duration": {
    "press": "100ms",
    "release": "200ms",
    "hover": "150ms",
    "exit": "120ms",
    "fast": "180ms",
    "base": "220ms",
    "slow": "300ms",
    "morph": "360ms"
  }
}
