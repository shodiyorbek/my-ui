{
  "$description": "Soft/clean house tokens. Colors are semantic roles with light and dark values. text-faint is for disabled/decorative text only (below 4.5:1 by design). Edit here, then run: python scripts/build_tokens.py",
  "color": {
    "bg":           { "light": "#ffffff", "dark": "#212121" },
    "bg-subtle":    { "light": "#f9f9f9", "dark": "#181818" },
    "surface":      { "light": "#ffffff", "dark": "#2a2a2a" },
    "surface-hover":{ "light": "#f3f3f3", "dark": "#333333" },
    "surface-active":{ "light": "#ececec", "dark": "#3a3a3a" },
    "text":         { "light": "#0d0d0d", "dark": "#ececec" },
    "text-muted":   { "light": "#5d5d5d", "dark": "#b4b4b4" },
    "text-faint":   { "light": "#8f8f8f", "dark": "#8a8a8a" },
    "border":       { "light": "#0000000f", "dark": "#ffffff14" },
    "primary":      { "light": "#0d0d0d", "dark": "#f3f3f3" },
    "primary-fg":   { "light": "#ffffff", "dark": "#0d0d0d" },
    "accent":       { "light": "#2563eb", "dark": "#6b9cff" },
    "danger":       { "light": "#c42b36", "dark": "#ff6b6b" },
    "success":      { "light": "#1a7f4b", "dark": "#4cc38a" },
    "focus":        { "light": "#2563eb80", "dark": "#6b9cff99" },
    "scrim":        { "light": "#0000004d", "dark": "#00000080" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "full": "9999px" },
  "size": { "control-sm": "32px", "control": "36px", "control-lg": "40px", "touch": "44px", "sidebar": "272px", "reading": "720px" },
  "font": {
    "sans": "ui-sans-serif, -apple-system, system-ui, 'Segoe UI', Inter, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace"
  },
  "text": { "xs": "12px", "sm": "13px", "base": "14px", "md": "16px", "lg": "20px", "xl": "24px", "2xl": "32px" },
  "weight": { "regular": "400", "medium": "500", "semibold": "600" },
  "leading": { "tight": "1.2", "snug": "1.35", "normal": "1.5", "relaxed": "1.65" },
  "shadow": {
    "ring":    { "light": "0 0 0 1px oklch(0 0 0 / 0.06), 0 1px 2px -1px oklch(0 0 0 / 0.06), 0 2px 4px 0 oklch(0 0 0 / 0.04)", "dark": "0 0 0 1px oklch(1 0 0 / 0.08)" },
    "float":   { "light": "0 0 0 1px oklch(0 0 0 / 0.06), 0 4px 12px -2px oklch(0 0 0 / 0.08), 0 12px 32px -8px oklch(0 0 0 / 0.10)", "dark": "0 0 0 1px oklch(1 0 0 / 0.10), 0 8px 24px -4px oklch(0 0 0 / 0.5)" },
    "overlay": { "light": "0 0 0 1px oklch(0 0 0 / 0.05), 0 24px 64px -12px oklch(0 0 0 / 0.20)", "dark": "0 0 0 1px oklch(1 0 0 / 0.10), 0 24px 64px -12px oklch(0 0 0 / 0.6)" }
  },
  "ease": {
    "out": "cubic-bezier(0.23, 1, 0.32, 1)",
    "in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
    "drawer": "cubic-bezier(0.32, 0.72, 0, 1)"
  },
  "duration": { "press": "120ms", "hover": "150ms", "fast": "180ms", "base": "220ms", "slow": "300ms" }
}
